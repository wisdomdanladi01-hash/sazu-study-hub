APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://learning_platform:replace-me@localhost:5432/learning_platform_dev
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PRIVATE_STORAGE_DIR=private_storage
RESOURCE_MAX_BYTES=52428800
DEFAULT_SEMESTER_SUBSCRIPTION_PRICE_MINOR=100000

# Paystack test keys only. Never commit real credentials.
PAYSTACK_SECRET_KEY=sk_test_replace-me
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/return
PAYSTACK_TIMEOUT_SECONDS=10
PAYSTACK_LIVE_ENABLED=false

# Secure viewer / offline
STUDENT_DOWNLOADS_ENABLED=false
OFFLINE_ENABLED=true
OFFLINE_MAX_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Email Verification & Password Reset (Brevo API or SMTP)
# Generate API key in Brevo -> SMTP & API -> API Keys (starts with xkeysib-)
BREVO_API_KEY=xkeysib-replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=wisdomdavid0307@gmail.com
BREVO_SENDER_NAME="SAZU Study Hub"

# Optional SMTP Relay fallback (Brevo SMTP starts with xsmtpsib- on port 587 or 465)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-account-email@gmail.com
# SMTP_PASSWORD=xsmtpsib-your-brevo-smtp-key
# SMTP_TLS=true
